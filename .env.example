# Variables de entorno para Fénix (LocalStack y Laboratorio)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Prefijo de colas y pertenencia de recursos del grupo
QUEUE_PREFIX=fenix-grupo01
GROUP_ID=grupo01

# Secreto compartido para autenticación HMAC de webhooks (mínimo 16 caracteres)
WEBHOOK_SECRET=clave_secreta_super_segura_fenix_32b

# Canal de notificación: console (para pruebas locales), telegram o slack
NOTIFY_PROVIDER=console

# Configuración si se usa Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-1001234567890

# Configuración si se usa Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Configuración opcional para Docker Compose
LOCALSTACK_IMAGE=localstack/localstack:3.0
LOCALSTACK_AUTH_TOKEN=

